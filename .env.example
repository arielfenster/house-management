# Copy to .env and fill in. Never commit .env.
# Local values: run `npm run db:start`, then `npx supabase status -o env`
# (API_URL -> SUPABASE_URL, PUBLISHABLE_KEY -> SUPABASE_KEY, SECRET_KEY -> SUPABASE_SECRET_KEY).

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=                 # publishable (anon) key: safe for the browser
SUPABASE_SECRET_KEY=          # secret (service role) key: server-only, never exposed to the client
